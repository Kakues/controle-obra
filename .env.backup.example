# Copie para .env.backup no notebook (servidor) e ajuste os valores.
# Este arquivo NÃO deve ir para o git com senhas reais.

# Pasta local dos dumps no notebook
# DESTINO=/home/SEU_USUARIO/controle-obra/storage/backups

# Quantos arquivos locais manter
MANTER=14

# Enviar automaticamente para o PC?
# COPIAR_PARA_PC=1

# Destino SCP no seu computador Windows (com OpenSSH Server ligado)
# Formato: usuario@IP_DO_PC:caminho
#
# Exemplo (ajuste usuário e IP):
# PC_DESTINO=kakam@192.168.1.68:C:/Users/kakam/backups-controle-obra/
PC_DESTINO=
